# Copy this to .env and fill in real values. .env is gitignored and must
# never be committed.
#
# cp .env.example .env

APP_ENV=dev

# For building the schema, running roles/grants and running tests, this
# needs to be an administrative account.
DB_USER=root
DB_PASSWORD=YourNewPassword123!

# The application itself should connect as svc_orders, which only has
# EXECUTE on the order procedures and no direct table access at all.
# See sql/security/01_roles_and_grants.sql.
# DB_USER=svc_orders
# DB_PASSWORD=
